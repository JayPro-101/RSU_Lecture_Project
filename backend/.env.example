PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rsu_lecture_db?schema=public"

JWT_ACCESS_SECRET="dev-insecure-access-secret-rsu-lecture-platform-key-32chars"
JWT_ACCESS_EXPIRATION="15m"

JWT_REFRESH_SECRET="dev-insecure-refresh-secret-rsu-lecture-platform-key-32chars"
JWT_REFRESH_EXPIRATION="7d"

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Rate limiting for email resend in seconds
EMAIL_RESEND_COOLDOWN_SECONDS=60

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Email Provider: 'sendlib', 'nodemailer', 'smtp', or 'console'
EMAIL_PROVIDER="sendlib"

# Sendlib configuration
SEND_LIB_API_KEY=""
SEND_LIB_FROM="RSU Lecture Platform <no-reply@rsu.edu.ng>"

# Local SMTP / Nodemailer configuration (e.g. MailHog, Mailpit on localhost:1025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="RSU Lecture Platform <no-reply@rsu.edu.ng>"
